# Public Supabase connection values (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# HMAC key used to fingerprint checkout idempotency requests and hash rate-limit identifiers.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_HMAC_SECRET=replace-with-at-least-32-random-bytes-in-hex

# Public site origin used for canonical URLs in deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: order-created Telegram alerts (server-side only).
# Obtain the bot token from @BotFather and the target chat ID from your Telegram bot/chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
